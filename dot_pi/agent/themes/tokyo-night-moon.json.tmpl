{{- /*
=============================================================================
tokyo-night-moon.json.tmpl → ~/.pi/agent/themes/tokyo-night-moon.json

Pi theme. The `vars` block holds the literal Moon palette as hex; the
`colors` block references those names (e.g. "border": "bgHighlight"). Only
the hex literals are templated from .chezmoidata.yaml so the palette is
single-sourced; the name references stay literal strings Pi resolves
internally. Rendered output is valid JSON — verify with `jq empty`.
=============================================================================
*/ -}}
{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "tokyo-night-moon",
  "vars": {
    "bg": "{{ .theme.tokyo_night_moon.bg }}",
    "bgDark": "{{ .theme.tokyo_night_moon.bg_dark }}",
    "bgHighlight": "{{ .theme.tokyo_night_moon.fg_gutter }}",
    "fg": "{{ .theme.tokyo_night_moon.fg }}",
    "fgGutter": "{{ .theme.tokyo_night_moon.dark5 }}",
    "comment": "{{ .theme.tokyo_night_moon.comment }}",
    "blue": "{{ .theme.tokyo_night_moon.blue }}",
    "cyan": "{{ .theme.tokyo_night_moon.cyan }}",
    "green": "{{ .theme.tokyo_night_moon.green }}",
    "magenta": "{{ .theme.tokyo_night_moon.magenta }}",
    "orange": "{{ .theme.tokyo_night_moon.orange }}",
    "red": "{{ .theme.tokyo_night_moon.red }}",
    "yellow": "{{ .theme.tokyo_night_moon.yellow }}",
    "selection": "{{ .theme.tokyo_night_moon.selection }}",
    "tintGreen": "{{ .theme.tokyo_night_moon.tint_green }}",
    "tintRed": "{{ .theme.tokyo_night_moon.tint_red }}"
  },
  "colors": {
    "accent": "blue",
    "border": "bgHighlight",
    "borderAccent": "blue",
    "borderMuted": "bgDark",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "fgGutter",
    "dim": "comment",
    "text": "",
    "thinkingText": "fgGutter",

    "selectedBg": "selection",
    "userMessageBg": "bgDark",
    "userMessageText": "",
    "customMessageBg": "bgDark",
    "customMessageText": "",
    "customMessageLabel": "magenta",
    "toolPendingBg": "bgDark",
    "toolSuccessBg": "tintGreen",
    "toolErrorBg": "tintRed",
    "toolTitle": "blue",
    "toolOutput": "fgGutter",

    "mdHeading": "orange",
    "mdLink": "blue",
    "mdLinkUrl": "comment",
    "mdCode": "blue",
    "mdCodeBlock": "green",
    "mdCodeBlockBorder": "bgHighlight",
    "mdQuote": "fgGutter",
    "mdQuoteBorder": "bgHighlight",
    "mdHr": "bgHighlight",
    "mdListBullet": "cyan",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "comment",

    "syntaxComment": "comment",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "yellow",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "{{ .theme.tokyo_night_moon.fg_dark }}",

    "thinkingOff": "bgHighlight",
    "thinkingMinimal": "comment",
    "thinkingLow": "{{ .theme.tokyo_night_moon.blue1 }}",
    "thinkingMedium": "blue",
    "thinkingHigh": "magenta",
    "thinkingXhigh": "red",
    "thinkingMax": "orange",

    "bashMode": "cyan"
  },
  "export": {
    "pageBg": "{{ .theme.tokyo_night_moon.page_bg }}",
    "cardBg": "bgDark",
    "infoBg": "bgHighlight"
  }
}