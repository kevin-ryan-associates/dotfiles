{{- /*
=============================================================================
install-packages.sh.tmpl — converged machine-state installer (macOS)

This single template replaces the legacy bootstrap.sh, install-mac.sh,
install-linux.sh, and brew-packages.sh quartet. Per AGENTS.md, the install
logic now lives in chezmoi alongside the config it complements. The Linux
(Ubuntu) path has been retired for now; macOS is the supported target. The
Linux branch can be re-added later by reintroducing an
`{{- else if eq .chezmoi.os "linux" }}` arm and the `linux:` section of
`.chezmoidata.yaml`.

`run_once_before_` semantics:
  • `run_`     — treat contents as a bash script
  • `once_`    — run only when this script's source content has not yet run
                 successfully (idempotent across applies until the script
                 itself changes)
  • `before_`  — run during step 4 of the application order, BEFORE any file
                 targets are written. This guarantees brew is on disk and on
                 PATH (after the `eval "$(.../brew shellenv)"` line below)
                 before any subsequent `*_dot_zprofile.tmpl` resolves.

Brew is installed lazily on first apply (if missing). PATH for child processes
of this script is updated in-process via `eval "$(.../brew shellenv)"` so the
`brew install` lines below work even on a fresh machine where Homebrew was
just installed.

Idempotent by construction: every step is a `brew install` (free for
already-installed formulae) or a guarded `command -v` skip.
=============================================================================
*/ -}}
#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}
# =============================================================================
# macOS install path — Homebrew for all tooling; Colima Docker runtime
# =============================================================================

echo "==> Checking for Homebrew..."
if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew not found. Installing from https://brew.sh ..."
  echo "(Requires Xcode Command Line Tools — a GUI dialog may appear for consent.)"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  # Homebrew's installer does NOT put brew on PATH for the current shell. Source
  # it in-process so the `brew install` lines below work this run.
  # Paths: /opt/homebrew (Apple Silicon), /usr/local (Intel).
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "ERROR: Homebrew install completed but brew not found at expected path." >&2
    exit 1
  fi
fi

echo "==> Installing Homebrew dependencies for Zsh ecosystem..."
brew install {{ range .packages.brew.main }}{{ . }} {{ end }}

echo "==> Installing CLI utilities..."
brew install {{ range .packages.brew.cli }}{{ . }} {{ end }}

echo "==> Installing Git platform CLIs..."
brew install {{ range .packages.brew.git_platform }}{{ . }} {{ end }}

echo "==> Installing Kubernetes tooling..."
brew install {{ range .packages.brew.k8s }}{{ . }} {{ end }}

echo "==> Installing build tools..."
brew install {{ range .packages.brew.build }}{{ . }} {{ end }}

echo "==> Installing 1Password CLI..."
brew install --cask 1password-cli || true

echo "==> Installing Colima (Docker runtime without GUI)..."
brew install {{ range .macos.brew.docker_runtime }}{{ . }} {{ end }}

echo "==> Installing Neovim and dependencies..."
brew install {{ range .packages.brew.dev }}{{ . }} {{ end }}

echo "==> Installing terminal emulator..."
brew install --cask ghostty || true
brew install --cask font-meslo-lg-nerd-font

echo "==> Installing OpenCode..."
curl -fsSL https://raw.githubusercontent.com/anomalyco/opencode/master/install -o /tmp/opencode-install.sh
bash /tmp/opencode-install.sh --no-modify-path
rm -f /tmp/opencode-install.sh

echo "==> Installing OpenSpec (spec-driven dev framework)..."
npm install -g {{ range .packages.npm_global }}{{ . }} {{ end }}

echo "==> Building bat theme cache..."
bat cache --build

{{- else }}
{{- fail (printf "unsupported OS: %s — this build targets macOS only (Linux support to be re-added later)" .chezmoi.os) -}}
{{- end }}

echo ""
echo "========================================"
echo "  Package install complete!"
echo "========================================"
echo ""
echo "Next steps (run separately, not part of this script):"
echo "  1. Open a new terminal window"
echo "  2. Zinit will auto-install on first run (~10-30s)"
echo "  3. Run 'nvim' to install AstroNvim plugins"
echo "  4. Run 'opencode auth' to authenticate"
{{- if eq .chezmoi.os "darwin" }}
echo "  5. Run 'colima start' to launch the Docker runtime"
{{- end }}