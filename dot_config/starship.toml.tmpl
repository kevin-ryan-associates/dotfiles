{{- /*
=============================================================================
starship.toml.tmpl → ~/.config/starship.toml

Tokyo Night Moon prompt. The `[palettes.tokyo_night]` table values are
rendered at apply time from .chezmoidata.yaml's `theme.tokyo_night_moon`
palette — so a color edit there propagates here on the next `chezmoi apply`.
Starship resolves `$palette` references at runtime; the rendered TOML still
defines the palette table with the literal hex values (templates expand to
those literals), so the deployed file is byte-identical to the pre-template
flat version.
=============================================================================
*/ -}}
# Starship config -- Tokyo Night Moon palette
# based on folke/tokyonight.nvim moon variant

"$schema" = 'https://starship.rs/config-schema.json'

format = """[](color_panel)\
$username\
[](bg:color_dir fg:color_panel)\
$directory\
[](fg:color_dir bg:color_git)\
$git_branch\
$git_status\
[](fg:color_git bg:color_lang)\
$python\
$nodejs\
$rust\
$golang\
$lua\
$docker_context\
$kubernetes\
[](fg:color_lang bg:color_time)\
$time\
[ ](fg:color_time)\
$character"""

palette = "tokyo_night"

[palettes.tokyo_night]
# panel backgrounds (dark)
color_panel = "{{ .theme.tokyo_night_moon.bg_alt }}"
color_dir   = "{{ .theme.tokyo_night_moon.bg }}"
color_git   = "{{ .theme.tokyo_night_moon.bg_highlight }}"
color_lang  = "{{ .theme.tokyo_night_moon.bg }}"
color_time  = "{{ .theme.tokyo_night_moon.bg_highlight }}"
# accents
color_cyan    = "{{ .theme.tokyo_night_moon.cyan }}"
color_green   = "{{ .theme.tokyo_night_moon.green }}"
color_magenta = "{{ .theme.tokyo_night_moon.magenta }}"
color_blue    = "{{ .theme.tokyo_night_moon.blue }}"
color_amber   = "{{ .theme.tokyo_night_moon.yellow }}"
color_red     = "{{ .theme.tokyo_night_moon.red }}"
color_text    = "{{ .theme.tokyo_night_moon.fg }}"
color_dim     = "{{ .theme.tokyo_night_moon.comment }}"

[os]
disabled = true

[username]
show_always = true
style_user = "bg:color_panel fg:color_text"
style_root = "bg:color_panel fg:color_red"
format = '[ $user ]($style)'

[directory]
style = "bg:color_dir fg:color_cyan"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = "󰇚"
"Music"     = "󰝚"
"Pictures"  = "󰉏"
"workspace" = "󰙴"

[git_branch]
symbol = "󰊢"
style = "bg:color_git fg:color_amber"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:color_git fg:color_magenta"
format = '[$all_status$ahead_behind ]($style)'

[python]
symbol = "󰌠"
style = "bg:color_lang fg:color_green"
format = '[ $symbol($version)(\($virtualenv\)) ]($style)'

[nodejs]
symbol = "󰎙"
style = "bg:color_lang fg:color_green"
format = '[ $symbol($version) ]($style)'

[rust]
symbol = "󱘗"
style = "bg:color_lang fg:color_amber"
format = '[ $symbol($version) ]($style)'

[golang]
symbol = "󰟓"
style = "bg:color_lang fg:color_cyan"
format = '[ $symbol($version) ]($style)'

[lua]
symbol = "󰢱"
style = "bg:color_lang fg:color_blue"
format = '[ $symbol($version) ]($style)'

[docker_context]
symbol = "󰡨"
style = "bg:color_lang fg:color_blue"
format = '[ $symbol$context ]($style)'

[kubernetes]
disabled = false
symbol = "󱃾"
style = "bg:color_lang fg:color_magenta"
format = '[ $symbol$context( \($namespace\)) ]($style)'

[time]
disabled = false
time_format = "%R"
style = "bg:color_time fg:color_cyan"
format = '[ 󰥔 $time ]($style)'

[character]
success_symbol = '[❯](bold {{ .theme.tokyo_night_moon.green }})'
error_symbol   = '[❯](bold {{ .theme.tokyo_night_moon.red }})'
vimcmd_symbol  = '[❮](bold {{ .theme.tokyo_night_moon.yellow }})'

[cmd_duration]
min_time = 500
format = "[ took $duration]($style) "
style = "fg:{{ .theme.tokyo_night_moon.yellow }}"
