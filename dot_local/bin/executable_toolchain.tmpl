#!/usr/bin/env bash
# toolchain — print a grouped table of every tool installed by
# kevin-ryan-associates/dotfiles (Title / Description / Help), themed in
# Tokyo Night Moon.
#
# Generated at `chezmoi apply` time from the `tools:` map in .chezmoidata.yaml.
# The install lists (packages.brew.*, macos.brew.*, packages.npm_global,
# pi.packages) drive iteration; `tools:` curates Title / Description / Help.
# A list entry with a missing tools: key renders a "(missing entry in tools
# map)" row so drift is obvious.
#
# The Help column is the help INVOCATION string (e.g. `glow --help`), not live
# paged output — running 40+ help binaries would be unusable.
#
# Template note: chezmoi renders with missingkey=error, so map fields are read
# via `index $e "field"` (safe for absent keys) instead of `.field` access, and
# resolved with sprig `default`. A nil $e (missing tools: entry) → else branch.
#
# Theming: column alignment is computed manually (NOT via `column`, which is
# not ANSI-aware and would miscount escape bytes). ANSI 24-bit truecolor codes
# are applied AFTER padding, so padding spaces are measured in visible chars
# and align correctly. Palette values are rendered from
# .chezmoidata.yaml's theme.tokyo_night_moon (single source of truth);
# editing a color there propagates to this command on the next `chezmoi apply`.
set -euo pipefail

# ---- Tokyo Night Moon palette (rendered from .chezmoidata.yaml) ----
TN_BLUE='{{ .theme.tokyo_night_moon.blue }}'
TN_CYAN='{{ .theme.tokyo_night_moon.cyan }}'
TN_MAGENTA='{{ .theme.tokyo_night_moon.magenta }}'
TN_FG='{{ .theme.tokyo_night_moon.fg }}'
TN_COMMENT='{{ .theme.tokyo_night_moon.comment }}'

usage() {
  cat <<'USAGE'
toolchain — every tool installed by kevin-ryan-associates/dotfiles

Usage:
  toolchain           print the grouped tool table (Title / Description / Help)
  toolchain -h|--help print this help

Columns:
  Title        the command/binary the user invokes
  Description  one-line purpose
  Help         help invocation string (e.g. `glow --help`), or — if none

Themed in Tokyo Night Moon. The table is generated at chezmoi apply time from
.chezmoidata.yaml's `tools:` map; it reflects DECLARED packages, not live
`brew list` state.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") : ;;
  *) printf 'toolchain: unknown argument %q\n' "$1" >&2; usage >&2; exit 2 ;;
esac

# col — wrap text in ANSI truecolor fg. $1=hex (#rrggbb) $2=text
col() {
  printf '\033[38;2;%d;%d;%dm%s\033[0m' \
    $((16#${1:1:2})) $((16#${1:3:2})) $((16#${1:5:2})) "$2"
}

# colb — bold + truecolor fg. $1=hex $2=text
colb() {
  printf '\033[1;38;2;%d;%d;%dm%s\033[0m' \
    $((16#${1:1:2})) $((16#${1:3:2})) $((16#${1:5:2})) "$2"
}

# _group — bold group header, then a 3-column aligned table read from stdin.
# Reads tab-separated rows, computes per-column widths from VISIBLE text,
# then emits color-wrapped fields padded with spaces. Padding is applied to
# the plain string before wrapping in ANSI so escape bytes don't corrupt it.
_group() {
  local label=$1
  printf '\n%s\n' "$(colb "$TN_CYAN" "$label")"
  local -a T=() D=() H=()
  local a b c w1=0 w2=0 i n
  local IFS=$'\t'
  while read -r a b c; do
    T+=("$a"); D+=("$b"); H+=("$c")
    w1=$(( w1 > ${#a} ? w1 : ${#a} ))
    w2=$(( w2 > ${#b} ? w2 : ${#b} ))
  done
  n=${#T[@]}
  for ((i = 0; i < n; i++)); do
    printf '%s%*s  %s%*s  %s\n' \
      "$(col "$TN_BLUE"    "${T[i]}")" $((w1 - ${#T[i]})) '' \
      "$(col "$TN_FG"      "${D[i]}")" $((w2 - ${#D[i]})) '' \
      "$(col "$TN_COMMENT" "${H[i]}")"
  done
  printf '\n'
}

# render-row: emit one row for a (key, entry) pair. Help defaults to
# "<title> --help". An absent tools: entry yields a glaring "(missing …)" row.
{{ define "render-row" -}}{{- $key := .key -}}{{- $e := .e -}}{{- if $e -}}{{- $t := default (base $key) (index $e "title") -}}{{- $h := default (printf "%s --help" $t) (index $e "help") -}}{{ printf "%s\t%s\t%s\n" $t (default "(no description)" (index $e "desc")) $h }}{{- else -}}{{ printf "%s\t(missing entry in tools map)\t—\n" $key }}{{- end -}}{{- end }}

printf '%s — %s\n\n' \
  "$(colb "$TN_MAGENTA" 'Toolchain')" \
  "$(col "$TN_COMMENT" 'installed by kevin-ryan-associates/dotfiles')"

_group "Zsh ecosystem" <<'ROWS'
{{ range .packages.brew.main }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "CLI utilities" <<'ROWS'
{{ range .packages.brew.cli }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Git platform CLIs" <<'ROWS'
{{ range .packages.brew.git_platform }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Cloud platform CLIs" <<'ROWS'
{{ range .packages.brew.cloud }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Kubernetes" <<'ROWS'
{{ range .packages.brew.k8s }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Build tools" <<'ROWS'
{{ range .packages.brew.build }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Neovim + language runtimes" <<'ROWS'
{{ range .packages.brew.dev }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Docker runtime (macOS)" <<'ROWS'
{{ range .macos.brew.docker_runtime }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Homebrew casks (macOS GUI / fonts)" <<'ROWS'
{{ range .macos.brew.casks }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "npm globals" <<'ROWS'
{{ range .packages.npm_global }}{{ template "render-row" (dict "key" . "e" (index $.tools .)) }}{{ end -}}
ROWS

_group "Pi agent packages" <<'ROWS'
{{ range .pi.packages }}{{- $e := index $.tools . -}}{{- if $e -}}{{- $t := default (base .) (index $e "title") -}}{{- $h := default "pi --help" (index $e "help") -}}{{ printf "%s\t%s\t%s\n" $t (default "(no description)" (index $e "desc")) $h }}{{- else -}}{{ printf "%s\t(missing entry in tools map)\t—\n" . }}{{- end -}}{{ end -}}
ROWS

