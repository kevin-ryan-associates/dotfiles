{{- /*
=============================================================================
dotfiles chezmoi init config template

Rendered once by `chezmoi init kevin-ryan-associates/dotfiles` into
~/.config/chezmoi/chezmoi.toml. Re-rendered when `chezmoi init` or
`chezmoi update` runs. Edit the template source, not the rendered file.

Mirrors the early-fail behavior of the legacy bootstrap.sh: if git (the one
prerequisite chezmoi itself can't install) isn't on PATH, fail loudly with the
platform-appropriate install hint instead of letting a `git clone` trigger a
system dialog mid-script.
=============================================================================
*/ -}}
{{- if not (lookPath "git") -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     fail "git not found. Install Xcode Command Line Tools first: xcode-select --install" -}}
{{-   else if eq .chezmoi.os "linux" -}}
{{-     fail "git not found. Install first: sudo apt-get update && sudo apt-get install -y git" -}}
{{-   else -}}
{{-     fail "git not found; install git before running chezmoi init" -}}
{{-   end -}}
{{- end -}}
